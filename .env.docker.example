# Copy to .env before running docker compose. These drive the api + db containers.

# --- Database (used by both db and api containers) ---
DB_NAME=roomlink
DB_USER=roomlink
DB_PASSWORD=change-me-strong
DB_ROOT_PASSWORD=change-me-root

# --- Payment service ---
SERVICE_FEE_RATE=0.40
PAYMENT_PROVIDER=mock            # mock | azampay
PUBLIC_BASE_URL=https://your-domain.com   # the gateway calls /api/payments/webhook here
PAYMENT_WEBHOOK_SECRET=change-me-long-random

# --- AzamPay (only when PAYMENT_PROVIDER=azampay) ---
AZAMPAY_BASE_URL=https://sandbox.azampay.co.tz
AZAMPAY_TOKEN=
